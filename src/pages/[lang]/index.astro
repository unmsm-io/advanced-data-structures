---
import Base from "../../layouts/Base.astro";
import { LANGS, UI, fmt } from "../../i18n/ui.mjs";
import { UNITS, WEEKS, LESSONS } from "../../lessons/index.mjs";
import { pad2 } from "../../lib/shell.mjs";
export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const { lang } = Astro.params;
const u = UI[lang];
const other = lang === "en" ? "es" : "en";
const total = WEEKS.filter((w) => !/exam/i.test(w.topic.en)).length;
const h1 = u.course.replace(u.courseAccent, `<span>${u.courseAccent}</span>`);
---
<Base title={u.course} lang={lang} alt={`/${other}/`}>
<div class="lz">
<header class="hero"><div><div class="kicker">{u.school}</div><h1 set:html={h1} /><p class="lede">{u.lede} {fmt(u.ready, { done: LESSONS.length, total })}.</p></div><div class="meta"><span>{u.credits}</span></div></header>
<div class="units">
{UNITS.map((unit) => (
<section class="unit"><h2><small>{u.unit.toUpperCase()} {unit.n}</small>{unit.title[lang]}</h2>
{unit.weeks.map((w) => w.lesson
  ? <a class="row live" href={`/${lang}/${w.lesson.slug}/`}><span class="wk">{pad2(w.w)}</span><span class="tp"><b>{w.topic[lang]}</b><em>{w.lesson.machine[lang]}</em></span><span class="st">{u.open}</span></a>
  : <div class="row"><span class="wk">{pad2(w.w)}</span><span class="tp"><b>{w.topic[lang]}</b></span><span class="st">{/exam/i.test(w.topic.en) ? "" : u.soon}</span></div>)}
</section>))}
</div></div>
</Base>
<style is:global>
.units{display:grid;gap:36px;padding:36px 0}
.unit h2{font:400 30px/1.1 "Instrument Serif",serif;margin:0 0 12px}.unit h2 small{display:block;font:600 11px Inter;letter-spacing:.12em;color:var(--acc);margin-bottom:6px}
.row{display:grid;grid-template-columns:48px 1fr auto;gap:16px;align-items:center;padding:14px 16px;border-top:1px solid var(--rule);color:inherit;text-decoration:none}
.row:last-child{border-bottom:1px solid var(--rule)}
.row .wk{font:600 13px "JetBrains Mono",monospace;opacity:.5}
.row b{display:block;font:500 15px Inter}.row em{display:block;font-style:normal;font-size:13px;opacity:.55;margin-top:2px}
.row .st{font:500 12px Inter;opacity:.45}
.row.live{background:color-mix(in srgb,var(--acc) 7%,transparent)}.row.live .st{color:var(--acc);opacity:1;font-weight:600}.row.live:hover{background:color-mix(in srgb,var(--acc) 13%,transparent)}
</style>
